services:

  global-nginx:
    image: nginx:1.29-alpine
    container_name: global-nginx

    restart: unless-stopped

    ports:
      - "80:80"
      - "443:443"

    extra_hosts:
      - "host.docker.internal:host-gateway"

    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro

    networks:
      - global

networks:
  global:
    driver: bridge